```xml
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="毫秒计时点击器"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="时间基准" />

        <RadioGroup
            android:id="@+id/timeSourceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/systemTimeRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统时间"
                android:checked="true" />

            <RadioButton
                android:id="@+id/networkTimeRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网络世界时间" />
        </RadioGroup>

        <TextView
            android:id="@+id/currentTimeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前时间：--:--:--.---"
            android:textSize="20sp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="目标时间（HH:mm:ss.SSS）" />

        <EditText
            android:id="@+id/targetTimeEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="09:30:15.123"
            android:inputType="time"
            android:text="09:30:15.123" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提前 / 延迟（毫秒）"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/offsetMsEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="numberSigned"
            android:text="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击坐标 X"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/xEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：500"
            android:inputType="number"
            android:text="500" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击坐标 Y"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/yEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：1000"
            android:inputType="number"
            android:text="1000" />

        <Button
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开无障碍设置"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/testClickButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即测试点击"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始定时点击"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="停止"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="倒计时：未开始"
            android:textSize="18sp"
            android:paddingTop="16dp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态：等待操作"
            android:paddingTop="8dp" />

    </LinearLayout>

</ScrollView>
```
